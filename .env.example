# Local development uses SQLite. Set these values in Render's Environment panel
# for shared operation. Never commit actual credentials.
PPCM_MODE=cloud
PUBLIC_APP_URL=https://your-service.onrender.com
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GITHUB_REPOSITORY=Frezer0/PPCM
# Optional for private releases / higher GitHub API rate limit (server only):
# GITHUB_RELEASE_TOKEN=
# Optional: Supabase CA certificate if required by your project's certificate chain.
# SUPABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
